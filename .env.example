# Copy to .env (ignored by Git); never commit your populated file.
# Private-client mode: generate a random value with python -c 'import secrets; print(secrets.token_urlsafe(48))'
OPENPKLAB_TOKEN=
# For ChatGPT, configure OAuth instead of relying on a private API token.
OPENPKLAB_DOMAIN=
OPENPKLAB_PUBLIC_URL=
OPENPKLAB_OAUTH_ISSUER=
OPENPKLAB_OAUTH_AUDIENCE=
OPENPKLAB_OAUTH_JWKS_URL=
OPENPKLAB_OWNER_SUB=
